# Cabeceras de Resonar (Cloudflare static assets)
# NO añadir Content-Security-Policy: bloquea el script inline y la app se queda en negro.

/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), screen-wake-lock=(self), autoplay=*, encrypted-media=*, fullscreen=*, picture-in-picture=*, accelerometer=*, gyroscope=*
  Cache-Control: no-cache

/sw.js
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  ! Cache-Control
  Cache-Control: public, max-age=86400

/icon-*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/og-image.jpg
  ! Cache-Control
  Cache-Control: public, max-age=604800

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/ai/ort/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/ai/*.onnx
  ! Cache-Control
  Cache-Control: public, max-age=2592000
