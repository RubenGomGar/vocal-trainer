{
  "name": "resonar",
  "private": true,
  "version": "1.0.0",
  "description": "Resonar \u00b7 app web de entrenamiento vocal (Cloudflare Worker \u00abvocal\u00bb)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:staging": "node scripts/build.mjs staging",
    "dev": "node scripts/build.mjs staging && wrangler dev",
    "deploy": "node scripts/build.mjs production && wrangler deploy",
    "deploy:staging": "node scripts/build.mjs staging && wrangler deploy --env staging",
    "check": "node scripts/check.mjs",
    "bench": "node scripts/bench/index.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
