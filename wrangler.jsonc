{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // El build (scripts/build.mjs) genera dist/ desde public/
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "RESONAR", "id": "d2a6e98ce89c4553bee96d0673080ae0" }
  ],
  // Límite nativo contra spam en /api/feedback y /api/log (10 peticiones por minuto y clave)
  "ratelimits": [
    { "name": "RL", "namespace_id": "3401", "simple": { "limit": 10, "period": 60 } }
  ],
  // Cuando tengas el dominio, descomenta y pon el tuyo:
  // "routes": [
  //   { "pattern": "resonar.app", "custom_domain": true },
  //   { "pattern": "www.resonar.app", "custom_domain": true }
  // ],

  "env": {
    // Worker «vocal-staging»: npx wrangler deploy --env staging
    "staging": {
      "workers_dev": true,
      "kv_namespaces": [
        { "binding": "RESONAR", "id": "fe733e379f4c4fcea6a3339ab8fb33ca" }
      ],
      "ratelimits": [
        { "name": "RL", "namespace_id": "3402", "simple": { "limit": 10, "period": 60 } }
      ]
      // Con dominio: "routes": [{ "pattern": "beta.resonar.app", "custom_domain": true }]
    }
  }
  // Secretos (no van aquí):
  //   npx wrangler secret put ADMIN_KEY
  //   npx wrangler secret put ADMIN_KEY --env staging
}
